{
  "expo": {
    "name": "KATSU",
    "slug": "app",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kisshi.gradhabit",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "ja"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-widget-cancels-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B2A28",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-quick-actions",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.kisshi.gradhabit.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.kisshi.gradhabit",
          "widgets": [
            {
              "name": "KatsuProgress",
              "displayName": "KATSU",
              "description": "Day N / 66",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f38209f-8ecc-4df5-a507-6e1fc55417fc"
      },
      "revenueCatApiKey": "appl_nHyRnlntucFoYnDwhFdfOfNeIiu"
    }
  }
}
